*.py[cod]

build/
dist/
*.egg-info/
__pycache__/
# Python build artifacts
bindings/python/HE/__pycache__
bindings/python/metta/__pycache__
python/__pycache__
bindings/python/tests/__pycache__
repos/

# Compiled C extension example, built by check.sh when a compiler is present
examples/integration/c_extension/*.so

# The opt-in mypyc build (PETTA_USE_MYPYC=1), which writes extensions beside
# the source they were built from. Shipping one would also SHADOW the pure
# Python module for every later run in the checkout, so it is ignored and
# check.sh's own build is out of tree.
python/*.so
bindings/python/metta/*.so

# Agent scratch: books, cloned prior art, gate logs, tree copies. Never
# released, and skipped by .codespellrc for the same reason.
ai-tmp/

# The Node binding fetches swipl-wasm with npm; it is a build input, not
# source, and the same shape as any other node_modules in the tree.
bindings/node/node_modules/
