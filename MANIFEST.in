recursive-include engine *
recursive-include lib *
recursive-exclude engine __pycache__ *.py[co]
recursive-exclude lib __pycache__ *.py[co]
# Build artifacts a dev tree carries: a shipped .qlf silently shadows the
# shipped source and ties the install to the builder's SWI version
# (engine/qlf_boot.pl regenerates per install), and a .so is one machine's
# binary in a py3-none-any package.
recursive-exclude engine *.qlf .qlf-stamp *.so *.o
recursive-exclude lib *.qlf *.so *.o
include extensions/python/helper.pl
include CHANGELOG.md
include CITATION.cff
include SECURITY.md

# Everything setup.py's RUNTIME_RESOURCES maps into metta/_runtime/ must be in
# the SDIST too, or `pip install` from PyPI fails: `python -m build` builds the
# wheel FROM the sdist, so a resource the sdist drops is a resource the wheel
# build cannot find. Measured 2026-08-23: five of the nine mapped resources were
# absent and `python -m build` died on the first of them, the MORK seat's
# control file,
# while `python -m build --wheel` succeeded because it reads the working tree
# directly. CI only ever ran the second, so the path every installer takes was
# the one path never exercised. test_packaging.py derives its check from
# RUNTIME_RESOURCES itself so this cannot drift again.
include extensions/mork/extension.pl
recursive-include tests/codec *
include extensions/python/extension.pl
include extensions/python/bridge.pl
include extensions/python/metta_py.py
recursive-exclude tests/codec __pycache__ *.py[co]
