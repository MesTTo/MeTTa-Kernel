[codespell]
# Bare directory names, because codespell prunes a walked subdirectory by its
# NAME and a file by its full path. A ./-prefixed entry only matches when the
# walk starts at ., so it silently stops skipping the moment the runner passes
# explicit paths, which is how website/node_modules came back.
#
# ai-* is the workspace's own marker for agent scratch, local plans, todos and
# handoff notes. Skipping the prefix rather than each file keeps a new note
# from blocking a push over a typo in something that never ships.
skip = *.lock,*.pyc,*.svg,package-lock.json,.git,node_modules,__pycache__,build,dist,target,repos,ai-*,pymetta.egg-info
# intensional: NARS distinguishes intensional from extensional inheritance,
#   so every hit in lib_nars.metta is the correct term.
# DOut, SourceE: Prolog variable names in translator.pl and shim.pl.
# NotIn: the compiled-subset operator name in define.py.
# anc: the ancestor relation in first_steps.py, a MeTTa function name.
# checkking: check-king, greedy_chess.metta's function for whether a side's
#   king is in check. Its parameter is $king_side_to_check.
# Zar: a person, who wrote most of nilbc.metta and is credited by handle.
# reduct: term rewriting's own word for a term reachable in one step, used
#   throughout engine/trs.pl and the critical-pair oracle.
# buildt: the BuildT type parameter of build(atom, cls) overloads in
#   _convert_build.py and results.py, and of Rows.build.
# arithmetics: a file name rather than a word. hyperon-experimental's number
#   tokens live in lib/src/metta/runner/stdlib/arithmetics.rs, which
#   engine/parser.pl and tests/prolog/parser.plt cite for what upstream does with
#   a literal past binary64.
# ans: the Node seat's own name for an Answers handle, in extensions/node's
#   README and src/answers.ts, where it is the bound variable of every example.
#   Rewording twelve call sites to satisfy a dictionary would be the tail wagging
#   the dog, and the cost of the entry is that a genuine "ans" for "and" now goes
#   unreported, which is a typo this tree has never made.
# asSync: engine.ts's sync counterpart of asAsync, one pair reading
#   Symbol.iterator and Symbol.asyncIterator off the same holder. Renaming
#   either would break the symmetry that makes the pair readable.
# derails: the word, used correctly. "resolving a .qlf instead of the .pl
#   derails the load" is not "details".
ignore-words-list = intensional,dout,sourcee,notin,ba,nd,som,te,fo,anc,checkking,zar,reduct,reducts,arithmetics,buildt,ans,assync,derails
# Whole LINES that are known and stay unreported, matched verbatim. This is for
# vendored third-party source under tests/prolog/vendor, where a typo is
# upstream's text and correcting it would fork the file away from the copy its
# provenance header names. A word belongs in ignore-words-list when it is not a
# typo at all; `occurences` in list_util.pl is a typo, just not ours, and the
# difference matters because ignoring the WORD would stop codespell reporting it
# in prose this tree does own. An exclusion also expires by itself: change the
# vendored line and it stops matching.
exclude-file = .codespell-exclude
